# Top-level .editorconfig
root = true

# Apply to all C# files
[*.cs]
indent_style = space
indent_size = 4

# New line preferences
end_of_line = crlf
insert_final_newline = true

# Apply to all XML files
[*.xml]
indent_style = space
indent_size = 2

# New line preferences
end_of_line = crlf
insert_final_newline = true
